NODE_ENV=production
CHARLOTTENDAL_PUBLIC_ORIGIN=https://cda-tkl.trainmeet.app
CHARLOTTENDAL_FIELD_URL=/anlaggning/
CHARLOTTENDAL_TKL_URL=/
CHARLOTTENDAL_STATE_DIR=/var/lib/charlottendal-tkl
CHARLOTTENDAL_AUTH_MODE=password
CHARLOTTENDAL_AUTH_FILE=/var/lib/charlottendal-auth/auth.json
# Alternative mode: cloudflare. Requires all three settings below.
# CHARLOTTENDAL_ACCESS_ISSUER=https://YOUR-TEAM.cloudflareaccess.com
# CHARLOTTENDAL_ACCESS_AUD=YOUR-APPLICATION-AUDIENCE
# CHARLOTTENDAL_ACCESS_EMAIL=operator@example.test

# Optional verified TrainMeet HTTP-v1 server; credentials are paired in the panel.
# CHARLOTTENDAL_TRAINMEET_ORIGIN=https://verified-server.example

# Optional AI timetable import. Set the key securely on the server, never in browser code.
# OPENAI_API_KEY=
# CHARLOTTENDAL_TIMETABLE_MODEL=gpt-5-mini
